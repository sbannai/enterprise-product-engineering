# EPER isolated UAT input checklist (documentation only; not sourced by Terraform)
AWS_REGION=ap-south-2
AWS_ACCOUNT_ID=
VPC_ID=

# Comma-separated IDs; ALB subnets must be public and span >=2 AZs.
ALB_SUBNET_IDS=
# Comma-separated IDs; private task subnets must be separate from ALB subnets.
TASK_SUBNET_IDS=

# Fill only after domain ownership and DNS control are confirmed.
UAT_HOSTNAME=
ACM_CERTIFICATE_ARN=

# Approved tester public IPv4 CIDRs, comma-separated. Never use 0.0.0.0/0.
UAT_ALLOWED_CIDRS=

# Approved image identity: exact 40-character lowercase source commit SHA.
IMAGE_TAG=
BUILD_ID=

# Keep false until an explicit cost review and authorization to provision.
ALLOW_CHARGEABLE_PROVISIONING=false

# Scope control: do not change these baseline counts.
REQUIREMENT_COUNT=228
CHAPTER_COUNT=38
