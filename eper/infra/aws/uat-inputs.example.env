# EPER isolated UAT input template
# Region is fixed by the approved project decision. No cloud resources are created by this file.
AWS_REGION=ap-south-2

# Fill only after domain ownership and DNS control are confirmed.
UAT_HOSTNAME=
ACM_CERTIFICATE_ARN=

# Comma-separated approved tester public IPv4 CIDRs, e.g. 203.0.113.10/32.
# Example above is documentation-only; replace it with the real approved egress CIDR.
UAT_ALLOWED_CIDRS=

# Keep false until an explicit cost review and authorization to provision.
ALLOW_CHARGEABLE_PROVISIONING=false

# Scope control: do not change these baseline counts.
REQUIREMENT_COUNT=228
CHAPTER_COUNT=38
